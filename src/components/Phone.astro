---
// Mockup de iPhone (diretriz 2.4). Toda tela do app aparece aqui dentro.
// - screen: nome do arquivo em src/assets/screens/ (sem extensão), capturado do app com os dados da nota ¹.
//   Sem o arquivo, a tela mostra o texto alternativo (provisório, o build avisa).
// - layers: várias telas empilhadas no mesmo iPhone. A camada de movimento troca a ativa
//   (cenas fixas, hero). Sem movimento, fica a camada `rest`
//   (padrão: a última, o estado final).
// - video: nome do arquivo em public/video/ (sem extensão). A captura de mesmo nome vira o poster.
//   A camada de movimento decide quando carregar e tocar.
// - priority: para o iPhone da primeira tela (hero): carrega já e com prioridade alta (LCP).
// - crop: corta o iPhone pela borda ("bottom" mostra a metade de cima, "top" a de baixo).
// A moldura é desenhada em CSS, no formato do iPhone 17 Pro. [FALTA] trocar pela moldura oficial.
import { Picture, getImage } from "astro:assets";
import { findScreen } from "../lib/screens";

interface Layer {
  alt: string;
  screen?: string;
  // Roteiro do hero (motion.ts): palavra da headline que acende, como a tela entra,
  // toque [x, y] em % antes de sair, quanto tempo fica (ms) e se é a tela de repouso.
  word?: number;
  enter?: "rise" | "fade" | "cut";
  tap?: [number, number];
  hold?: number;
  rest?: boolean;
}

interface Props {
  alt: string;
  screen?: string;
  layers?: Layer[];
  rest?: number;
  video?: string;
  crop?: "top" | "bottom";
  width?: number;
  priority?: boolean;
}

const { alt, screen, layers, video, crop, width = 300, priority = false } = Astro.props;
const items: Layer[] = layers ?? [{ alt, screen: screen ?? video }];
const marked = items.findIndex((l) => l.rest);
const rest = Astro.props.rest ?? (marked >= 0 ? marked : items.length - 1);
const taps = items.some((l) => l.tap);

const images = items.map((l) => findScreen(l.screen));
const poster = video && images[0] ? (await getImage({ src: images[0], width: width * 2, format: "webp" })).src : undefined;
---

<figure
  class:list={["phone", crop && `crop-${crop}`]}
  style={`--w:${width}px;--n:${items.length}`}
  data-layers={items.length > 1 ? "" : undefined}
>
  <div class="frame" role="img" aria-label={alt}>
    <div class="screen">
      {
        video ? (
          <div class="layer" data-rest>
            <video muted loop playsinline preload="none" poster={poster} data-src={`/video/${video}.mp4`} />
          </div>
        ) : (
          items.map((l, i) => (
            <div
              class="layer"
              data-rest={i === rest ? "" : undefined}
              data-word={l.word}
              data-enter={l.enter}
              data-tap={l.tap?.join(",")}
              data-hold={l.hold}
            >
              {images[i] ? (
                <Picture
                  src={images[i]}
                  alt=""
                  widths={[width, width * 2]}
                  sizes={`${width}px`}
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  loading={priority && i === rest ? "eager" : "lazy"}
                  fetchpriority={priority && i === rest ? "high" : "auto"}
                />
              ) : (
                <span class="placeholder">{l.alt}</span>
              )}
            </div>
          ))
        )
      }
      {taps && <span class="tap" aria-hidden="true" />}
      <span class="island"></span>
    </div>
  </div>
  {
    video && (
      <button type="button" class="media-toggle" data-media-toggle hidden>
        Tocar
      </button>
    )
  }
</figure>

<style>
  .phone {
    position: relative;
    /* --phone-w deixa um contêiner (ex.: a cena fixa no celular) mudar o tamanho. */
    width: min(100%, var(--phone-w, var(--w)));
    margin-inline: auto;
    container-type: inline-size;
  }

  /* Proporção do iPhone 17 Pro (71,9 × 150 mm). */
  .frame {
    aspect-ratio: 71.9 / 150;
    padding: 3.4cqw;
    border-radius: 15.5cqw;
    background: #0a0b0d;
    box-shadow:
      inset 0 0 0 0.6cqw #3a3d41,
      0 0 0 1px var(--line-strong);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 12.4cqw;
    background: var(--surface-200);
  }

  .layer {
    position: absolute;
    inset: 0;
    background: var(--surface-200);
    opacity: 0;
  }

  .layer[data-rest] {
    opacity: 1;
  }

  /* Depois que o motion.ts assume (data-ready), quem manda é a classe is-active. O fade só com movimento. */
  [data-layers][data-ready] .layer {
    opacity: 0;
  }

  [data-layers][data-ready] .layer:global(.is-active) {
    opacity: 1;
  }

  :global(html.motion) [data-layers][data-ready] .layer {
    transition: opacity 260ms cubic-bezier(0.77, 0, 0.175, 1);
  }

  .screen :global(img),
  .screen video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* Toque simulado: um círculo translúcido, como o indicador de toque do iOS. */
  .tap {
    position: absolute;
    z-index: 50;
    width: 13cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(20, 23, 26, 0.35);
    box-shadow: 0 0 0 1.5cqw rgba(20, 23, 26, 0.12);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .island {
    position: absolute;
    z-index: 60;
    top: 2.7cqw;
    left: 50%;
    width: 31cqw;
    height: 9.2cqw;
    border-radius: 999px;
    background: #000;
    transform: translateX(-50%);
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 18cqw 10cqw;
    color: var(--ink-muted);
    font-size: max(0.75rem, 4.6cqw);
    text-align: center;
  }

  .media-toggle {
    position: absolute;
    right: 6cqw;
    bottom: 6cqw;
    min-width: 44px;
    min-height: 44px;
    padding-inline: 1rem;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--glass-nav);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    backdrop-filter: blur(12px) saturate(180%);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .media-toggle[hidden] {
    display: none;
  }

  /* Recorte pela borda: mostra só a metade de cima ou a de baixo do iPhone. */
  .crop-bottom,
  .crop-top {
    aspect-ratio: 71.9 / 90;
    overflow: hidden;
  }

  /* O corte some em branco, em vez de terminar seco na borda. */
  .crop-bottom {
    -webkit-mask-image: linear-gradient(#000 75%, transparent);
    mask-image: linear-gradient(#000 75%, transparent);
  }

  .crop-top .frame {
    transform: translateY(calc(100cqw * 90 / 71.9 - 100%));
  }
</style>
