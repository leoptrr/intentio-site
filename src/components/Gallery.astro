---
// Galeria horizontal (diretriz 2.5): scroll nativo com scroll-snap, setas e pontos de 44 px.
// Sem JS, o trilho continua rolando com o dedo, o trackpad ou as setas do teclado; os controles ficam ocultos.
interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<div class="gallery" data-gallery>
  <ul class="rail" tabindex="0" aria-label={label}>
    <slot />
  </ul>
  <div class="controls wrap" hidden>
    <div class="dots">
      {
        items.map((item, i) => (
          <button type="button" class="dot" data-dot={i} aria-label={`${item}, ${i + 1} de ${items.length}`}>
            <span />
          </button>
        ))
      }
    </div>
    <div class="paddles">
      <button type="button" class="paddle" data-prev aria-label="Destaque anterior">‹</button>
      <button type="button" class="paddle" data-next aria-label="Próximo destaque">›</button>
    </div>
  </div>
</div>

<script>
  const smooth = () => (matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth");

  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const rail = gallery.querySelector<HTMLElement>(".rail")!;
    const cards = [...rail.children] as HTMLElement[];
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const prev = gallery.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = gallery.querySelector<HTMLButtonElement>("[data-next]")!;
    // O primeiro card fica no recuo do trilho, que é igual ao scroll-padding.
    // (O estilo computado do scroll-padding pode vir como calc(), então não dá para lê-lo.)
    const start = () => cards[0].offsetLeft;
    const go = (i: number) => rail.scrollTo({ left: cards[i].offsetLeft - start(), behavior: smooth() });

    // Posições de encaixe de cada card; no fim do trilho várias viram o mesmo limite.
    const stops = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      return [...new Set(cards.map((c) => Math.min(Math.max(0, c.offsetLeft - start()), max)))];
    };
    const step = (dir: number) => {
      const x = rail.scrollLeft;
      const all = stops();
      const target = dir > 0 ? all.find((p) => p > x + 1) : all.findLast((p) => p < x - 1);
      if (target !== undefined) rail.scrollTo({ left: target, behavior: smooth() });
    };

    const update = () => {
      const x = rail.scrollLeft + start();
      const atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 1;
      // No fim do trilho os últimos cards não chegam ao início; o ativo passa a ser o último.
      const current = atEnd
        ? cards.length - 1
        : cards.reduce((best, c, i) => (Math.abs(c.offsetLeft - x) < Math.abs(cards[best].offsetLeft - x) ? i : best), 0);
      dots.forEach((d, i) => d.setAttribute("aria-current", String(i === current)));
      prev.disabled = rail.scrollLeft <= 1;
      next.disabled = atEnd;
    };

    let queued = false;
    rail.addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    }, { passive: true });
    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));

    gallery.querySelector<HTMLElement>(".controls")!.hidden = false;
    update();
  }
</script>

<style>
  .rail {
    position: relative;
    display: flex;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0 var(--gutter) 0.5rem;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 1240px) {
    .rail {
      padding-inline: calc((100% - var(--content)) / 2);
      scroll-padding-inline: calc((100% - var(--content)) / 2);
    }
  }

  .rail > :global(li) {
    flex: 0 0 min(78vw, 320px);
    scroll-snap-align: start;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
  }

  .controls[hidden] {
    display: none;
  }

  .dots {
    display: flex;
  }

  button {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
  }

  .dot span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background-color 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .dot[aria-current="true"] span {
    background: var(--ink);
  }

  /* No celular o deslize já é nativo; as setas só entram com espaço para elas. */
  .paddles {
    display: none;
    gap: 0.5rem;
  }

  @media (min-width: 735px) {
    .paddles {
      display: flex;
    }
  }

  .paddle {
    border-radius: 50%;
    background: var(--glass-platter);
    font-size: 1.5rem;
    line-height: 1;
  }

  .paddle:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>
