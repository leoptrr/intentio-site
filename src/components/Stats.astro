---
// Números em destaque. A nota (ex.: "¹") vai depois da última legenda.
// Valores que começam com número (ou R$) contam do zero ao entrar na tela (data-count).
import { rich } from "../lib/rich.mjs";

interface Props {
  items: { value: string; label: string }[];
  note?: string;
}

const { items, note = "" } = Astro.props;
---

<ul class="stats">
  {
    items.map((s, i) => (
      <li data-reveal>
        <span class="stat-value" data-count={/^(R\$\s?)?\d/.test(s.value) ? "" : undefined} set:html={rich(s.value)} />
        <span class="stat-label" set:html={rich(s.label + (i === items.length - 1 ? note : ""))} />
      </li>
    ))
  }
</ul>
