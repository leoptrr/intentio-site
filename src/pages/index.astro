---
// Landing page do Intentio, versão enxuta (22/10): hero com fundo vivo, passos em linhas que trocam a tela,
// uma grade de cartões e o fecho com o preço. Um h1 (hero), um h2 por seção, h3 nos itens.
// Movimento: data-reveal (entradas), Steps (passos), data-hero (vereditos); tudo em src/scripts/motion.ts.
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Cta from "../components/Cta.astro";
import Phone from "../components/Phone.astro";
import Steps from "../components/Steps.astro";
import HandPhone from "../components/HandPhone.astro";
import { rich, resetNotes } from "../lib/rich.mjs";

const c = Object.fromEntries((await getCollection("landing")).map((e) => [e.id, e.data as any]));

const missing = JSON.stringify(c).match(/\[FALTA[^\]]*\]/g);
if (missing) console.warn(`[landing] ${missing.length} texto(s) com [FALTA] antes de publicar:\n  ${missing.join("\n  ")}`);

resetNotes();
const { hero, avaliar, pagamentos, lancamentos, plano, privacidade, comecar, preco, perguntas, baixar, notas } = c;
const quanto = c["quanto-cabe"];
const meses = c["proximos-meses"];
const tiles = [quanto, lancamentos, plano];
---

<Layout title={c.meta.title} description={c.meta.description}>
  <Nav nav={c.nav} />

  <main>
    <section id="hero" class="hero" data-hero>
      <div class="wrap hero-grid">
        <div class="hero-text">
          <h1 class="hero-title">{hero.words.map((w: string, i: number) => <>{i > 0 && " "}<span data-word={i}>{w}</span></>)}</h1>
          <p class="lede" set:html={rich(hero.subtitle)} />
          <Cta position="hero" />
          <p class="note" set:html={rich(hero.note)} />
        </div>
        <div class="hero-card">
          <!-- Fundo vivo (exceção do design system para hero e fecho): manchas cinza e um halo laranja à deriva. -->
          <div class="live" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="halo"></span></div>
          <HandPhone alt={hero.visual} layers={hero.sequence} priority />
          <button type="button" class="hero-toggle" data-hero-toggle hidden>Pausar animação</button>
        </div>
      </div>
    </section>

    <section id="avaliar" class="section">
      <div class="wrap">
        <Steps alt={avaliar.alt} steps={avaliar.steps} numbered>
          <p class="eyebrow">{avaliar.eyebrow}</p>
          <h2 class="headline">{avaliar.title}</h2>
          <p class="lede" set:html={rich(avaliar.subtitle)} />
        </Steps>
        <ul class="verdicts">
          {
            avaliar.verdicts.map((v: any) => (
              <li class={`verdict verdict-${v.state}`} data-reveal>
                <h3>{v.word}</h3>
                <p set:html={rich(v.text)} />
              </li>
            ))
          }
        </ul>
        <p class="closing" data-reveal set:html={rich(avaliar.closing)} />
      </div>
    </section>

    <section id="visao" class="section tight">
      <div class="wrap">
        <h2 class="visually-hidden">Quanto cabe, lançamentos e plano</h2>
        <ul class="tiles">
          {
            tiles.map((t: any) => (
              <li class="tile" data-reveal>
                <div class="tile-text">
                  <p class="eyebrow">{t.eyebrow}</p>
                  <h3>{t.title}</h3>
                  <p set:html={rich(t.subtitle)} />
                </div>
                <Phone alt={t.visual} screen={t.screen} crop="bottom" width={240} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="proximos-meses" class="section">
      <div class="wrap">
        <Steps alt={meses.alt} steps={meses.steps} flip>
          <p class="eyebrow">{meses.eyebrow}</p>
          <h2 class="headline">{meses.title}</h2>
          <p class="lede" set:html={rich(meses.subtitle)} />
        </Steps>
      </div>
    </section>

    <section id="pagamentos" class="section">
      <div class="wrap">
        <Steps alt={pagamentos.alt} steps={pagamentos.steps}>
          <p class="eyebrow">{pagamentos.eyebrow}</p>
          <h2 class="headline">{pagamentos.title}</h2>
        </Steps>
      </div>
    </section>

    <section id="privacidade" class="section">
      <div class="wrap">
        <div data-reveal>
          <h2 class="headline">{privacidade.title}</h2>
          <p class="lede" set:html={rich(privacidade.subtitle)} />
        </div>
        <ul class="facts">
          {
            privacidade.items.map((i: any) => (
              <li data-reveal>
                <h3>{i.title}</h3>
                <p set:html={rich(i.text)} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="comecar" class="section">
      <div class="wrap">
        <Steps alt={comecar.alt} steps={comecar.steps} numbered flip>
          <h2 class="headline">{comecar.title}</h2>
        </Steps>
      </div>
    </section>

    <section id="preco" class="section tight">
      <div class="wrap">
        <div class="final" data-reveal>
          <div class="live" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="halo"></span></div>
          <h2 class="headline">{baixar.title}</h2>
          <p class="lede" set:html={rich(baixar.body)} />
          <ul class="plans">
            {
              preco.plans.map((p: any) => (
                <li>
                  <h3>{p.name}</h3>
                  <p class="plan-value">
                    <span set:html={rich(p.value)} /> <span class="plan-period">{p.period}</span>
                  </p>
                  <p class="plan-note" set:html={rich(p.note)} />
                </li>
              ))
            }
          </ul>
          <Cta position="final" />
        </div>
      </div>
    </section>

    <section id="perguntas" class="section">
      <div class="wrap faq">
        <h2 class="headline" data-reveal>{perguntas.title}</h2>
        <div class="accordion">
          {
            perguntas.items.map((i: any) => (
              <details>
                <summary>
                  <h3>{i.q}</h3>
                </summary>
                <p class="answer" set:html={rich(i.a)} />
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <h2 class="visually-hidden">Notas</h2>
      <ol class="notes">
        {
          notas.items.map((n: string, i: number) => (
            <li id={`nota-${i + 1}`}>
              <span set:html={rich(n)} />{" "}
              <a href={`#ref-${i + 1}`} aria-label={`Voltar à referência da nota ${i + 1}`}>↩</a>
            </li>
          ))
        }
      </ol>
      <p class="fine">{notas.examples}</p>
      <p class="fine">{notas.trademark}</p>
      <p class="fine">{notas.legal}</p>
    </div>
  </footer>
</Layout>

<script>
  import "../scripts/motion.ts";
</script>

<style>
  /* Hero */

  .hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) var(--section-pad);
  }

  .hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .hero-title {
    font-size: var(--fs-hero);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-title span {
    display: inline-block;
  }

  .hero .lede {
    margin-top: 1.25rem;
  }

  .note {
    margin-top: 0.75rem;
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }

  /* A palavra do veredito acende junto com a tela. 50% mantém 3:1 (texto grande). */
  :global(html.motion) .hero[data-ready] .hero-title span {
    opacity: 0.5;
    transition: opacity 260ms var(--ease-move);
  }

  :global(html.motion) .hero[data-ready] .hero-title span.is-lit,
  :global(html.motion) .hero.calm .hero-title span {
    opacity: 1;
  }

  /* O cartão tem a proporção da foto: a mão preenche tudo e o fundo vivo aparece por trás (multiply). */
  .hero-card {
    position: relative;
    width: min(100%, 460px);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 32px;
    background: var(--surface-raised);
    isolation: isolate;
  }

  /* O roteiro do hero anima as telas com Web Animations; a transição padrão das camadas sai daqui. */
  .hero-card :global(.layer) {
    transition: none !important;
  }

  .hero-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    min-height: 44px;
    padding-inline: 1rem;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--glass-nav);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    backdrop-filter: blur(12px) saturate(180%);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .hero-toggle[hidden] {
    display: none;
  }

  /* Fundo vivo: manchas cinza e um halo laranja em radial-gradient, à deriva só com transform. */
  .live {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .live span {
    position: absolute;
    border-radius: 50%;
  }

  .live .b1 {
    top: -30%;
    left: -25%;
    width: 90%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, #d9d9d5, transparent);
  }

  .live .b2 {
    right: -30%;
    bottom: -35%;
    width: 100%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(31, 92, 122, 0.22), transparent);
  }

  .live .halo {
    top: 10%;
    left: 30%;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(242, 107, 46, 0.42), transparent);
  }

  :global(html.motion) .live .b1 {
    animation: drift-1 22s var(--ease-move) infinite alternate;
  }

  :global(html.motion) .live .b2 {
    animation: drift-2 28s var(--ease-move) infinite alternate;
  }

  :global(html.motion) .live .halo {
    animation: drift-3 18s var(--ease-move) infinite alternate;
  }

  @keyframes drift-1 {
    to {
      transform: translate(25%, 20%) scale(1.15);
    }
  }

  @keyframes drift-2 {
    to {
      transform: translate(-20%, -25%) scale(0.9);
    }
  }

  @keyframes drift-3 {
    to {
      transform: translate(-35%, 30%) scale(1.2);
    }
  }

  /* Vereditos */

  .verdicts {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 735px) {
    .verdicts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .verdict {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg);
  }

  .verdict h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .verdict p {
    margin-top: 0.375rem;
    color: var(--ink);
  }

  .verdict-positive {
    background: var(--positive-soft);
  }

  .verdict-positive h3 {
    color: var(--positive);
  }

  .verdict-wait {
    background: var(--accent-soft);
  }

  .verdict-wait h3 {
    color: var(--accent-strong);
  }

  .verdict-negative {
    background: var(--negative-soft);
  }

  .verdict-negative h3 {
    color: var(--negative);
  }

  /* Grade de cartões: cada um com o texto em cima e a tela saindo de baixo. */

  .tight {
    padding-block: calc(var(--section-pad) / 2);
  }

  .tiles {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.75rem 1.5rem 0;
  }

  .tile h3 {
    margin-top: 0.375rem;
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .tile-text p:last-child {
    margin-top: 0.5rem;
    color: var(--ink-muted);
  }

  .tile :global(.phone) {
    margin-top: auto;
    -webkit-mask-image: none;
    mask-image: none;
  }

  /* Privacidade: fatos curtos em grade. */

  .facts {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 735px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facts li {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .facts h3 {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .facts p {
    margin-top: 0.25rem;
    color: var(--ink-muted);
  }

  /* Fecho com o preço, no mesmo fundo vivo do hero. */

  .final {
    position: relative;
    padding: clamp(2.5rem, 1.5rem + 4vw, 5rem) 1.5rem;
    overflow: hidden;
    border-radius: 32px;
    background: var(--surface-200);
    isolation: isolate;
    text-align: center;
  }

  .final > :not(.live) {
    margin-inline: auto;
  }

  /* Os dois planos, em cartões claros sobre o fundo vivo. */
  .plans {
    display: grid;
    gap: 0.75rem;
    max-width: 560px;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 600px) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .plans li {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--glass-stroke);
    border-radius: var(--radius-lg);
    background: var(--glass-sheet);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
  }

  .plans h3 {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .plan-value {
    margin-top: 0.25rem;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .plan-period {
    color: var(--ink-muted);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .plan-note {
    margin-top: 0.25rem;
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }

  .faq {
    max-width: 760px;
  }

  .footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }

  .notes {
    display: grid;
    gap: 0.25rem;
    max-width: 680px;
    padding-left: 1.25em;
  }

  .notes a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-block: -12px;
    text-decoration: none;
  }

  .fine {
    max-width: 680px;
    margin-top: 1rem;
  }
</style>
